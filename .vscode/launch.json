{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backtest",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_backtest.py",
      "args": [
        "--symbol",
        "BTC/USDT",
        "--timeframe",
        "15m",
        "--days",
        "90",
        "--fast",
        "9",
        "--slow",
        "21",
        "--signal-data",
        "index"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Live bot (DEMO)",
      "type": "debugpy",
