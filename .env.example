# Copy this file to ".env" and fill in your keys. Never share or commit .env.
# Create keys on OKX with "Read" + "Trade" permission only. NEVER enable "Withdraw".

# Demo trading keys (create them while OKX is switched to Demo Trading)
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSPHRASE=

# Live keys (only needed for --live)
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET=
OKX_LIVE_PASSPHRASE=
